# Data Agent configuration. Copy to .env and edit.
# Every setting is prefixed DATA_AGENT_ and is case-insensitive.
# Do not commit a filled-in .env: DATA_AGENT_API_KEYS is a live credential.

# ----------------- Application -----------------
DATA_AGENT_APP_NAME=Data Analysis Service & Distributed Insight Engine
DATA_AGENT_APP_VERSION=0.1.0
# Never enable DEBUG on a shared or public deployment.
DATA_AGENT_DEBUG=false

# ----------------- Server -----------------
# 0.0.0.0 binds every interface. Use 127.0.0.1 unless the port is firewalled.
DATA_AGENT_HOST=0.0.0.0
DATA_AGENT_PORT=8000

# ----------------- SECURITY: API key auth -----------------
# Comma-separated list of accepted keys, sent by clients as the X-API-Key header.
# Guards every /api/v1/** endpoint, including the ones that execute SQL
# mutations (/api/v1/ontology/actions/execute, /api/v1/tools/sql), write to
# external databases (/api/v1/retl/sync) and send outbound webhooks
# (/api/v1/retl/alert). Without a key set, anyone who can reach the port can do
# all of that.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Rotate by listing old and new together, then dropping the old one.
DATA_AGENT_API_KEYS=replace-me-with-a-generated-secret

# Policy when API_KEYS is empty:
#   true  (default) -> the app REFUSES TO START with a loud error. Chosen so a
#                      misconfiguration fails closed instead of silently
#                      serving an unauthenticated port.
#   false           -> auth is disabled and a warning is logged at startup.
#                      Local development on a loopback port only.
DATA_AGENT_REQUIRE_AUTH=true

# ----------------- SECURITY: CORS -----------------
# Explicit comma-separated origin list. "*" is not supported: combined with
# credentials it is rejected by browsers, and it would let any site on the
# internet drive this API using a visitor's cookies. The dashboard is served
# from this same origin, so it needs no extra entry beyond the host you deploy on.
# Add your real origin here, e.g. https://analytics.example.com
DATA_AGENT_CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ----------------- Observability -----------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
DATA_AGENT_LOG_LEVEL=INFO

# ----------------- MCP -----------------
DATA_AGENT_MCP_SERVER_NAME=data-analysis-service
DATA_AGENT_MCP_TRANSPORT=stdio
DATA_AGENT_MCP_SSE_PORT=8001

# ----------------- Sessions & memory -----------------
DATA_AGENT_SESSION_TTL_SECONDS=1800
DATA_AGENT_MAX_MEMORY_PER_SESSION_MB=4096
DATA_AGENT_DUCKDB_MEMORY_LIMIT=16GB
# Defaults to the host CPU count when unset.
# DATA_AGENT_DUCKDB_THREADS=8

# ----------------- Ray cluster -----------------
DATA_AGENT_ENABLE_RAY=false
# DATA_AGENT_RAY_ADDRESS=ray://127.0.0.1:10001

# ----------------- Arrow Flight -----------------
DATA_AGENT_FLIGHT_HOST=0.0.0.0
DATA_AGENT_FLIGHT_PORT=8815

# ----------------- CDC & streaming buffer -----------------
DATA_AGENT_RING_BUFFER_CAPACITY=100000
DATA_AGENT_STREAM_BATCH_INTERVAL_MS=500
